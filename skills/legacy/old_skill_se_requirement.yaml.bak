    output_schema:
      type: object
      required:
        - artifact
        - unresolved_questions
        - risk_list
        - quality_score
      properties:
        artifact:
          type: object
          description: 主�?求產?��?結�??��?
          properties:
            business_goal:
              type: string
            stakeholders:
              type: array
              items:
                type: object
                required: [name, role, expectation]
                properties:
                  name:
                    type: string
                  role:
                    type: string
                  expectation:
                    type: string
            moskow_backlog:
              type: object
              required: [must, should, could, wont]
              properties:
                must:
                  type: array
                  items:
                    type: string
                should:
                  type: array
                  items:
                    type: string
                could:
                  type: array
                  items:
                    type: string
                wont:
                  type: array
                  items:
                    type: string
            assumptions:
              type: array
              items:
                type: object
                required: [content, verified]
                properties:
                  content:
                    type: string
                  verified:
                    type: boolean
            conflict_list:
              type: array
              items:
                type: object
                required: [conflict_desc, impact]
                properties:
                  conflict_desc:
                    type: string
                  impact:
                    type: string
            unresolved_questions:
              type: array
              items:
                type: object
                required: [question, target_stakeholder]
                properties:
                  question:
                    type: string
                  target_stakeholder:
                    type: string
            risk_list:
              type: array
              items:
                type: object
                required: [risk_desc, level, impact, mitigation]
                properties:
                  risk_desc:
                    type: string
                  level:
                    type: string
                    enum: ["Critical", "High", "Medium", "Low"]
                  impact:
                    type: string
                  mitigation:
                    type: string
            quality_score:
              type: number
              minimum: 0
              maximum: 100
