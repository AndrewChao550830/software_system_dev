# Free Claude Code (FCC) connection settings
FCC_BASE_URL=http://127.0.0.1:8082
FCC_API_KEY=freecc
FCC_MODEL=claude-sonnet-4-20250514

# Failover models (comma-separated) – tried in order if primary fails
FCC_FAILOVER_MODELS=nvidia_nim/minimaxai/minimax-m3

# Retry settings for each model
FCC_RETRIES=2
FCC_MAX_TOKENS=32768

# Database file (will be created under ./db/ if relative)
DB_PATH=./db/se_agent.db

# Gate quality score threshold (0‑100)
QUALITY_THRESHOLD=70